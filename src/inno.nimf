#? stdtmpl | standard
#proc generateInnoSetup(c: ConfigData): string =
#  result = ""
#  let startMenuName = if c.app == appConsole: "Console for " & c.displayName
#                      else: c.displayName
#  let publisher = if c.authors.len > 0: c.authors[0] else: ""
; Default Template for NimInst
[Setup]
AppName=$c.displayName
AppVerName=$c.displayName $c.version
DefaultDirName={autopf}\$c.displayName
DefaultGroupName=$c.displayName
AllowNoIcons=yes
LicenseFile=${expandFilename(c.license)}
OutputBaseFilename=${if c.innosetup.installerName.len > 0: c.innosetup.installerName & "_" & c.version else: c.name & "_" & c.version}
Compression=lzma
SolidCompression=yes
PrivilegesRequired=admin
ArchitecturesInstallIn64BitMode=x64compatible
ChangesEnvironment=yes
Uninstallable=no
CreateUninstallRegKey=no
DisableDirPage=no
DisableProgramGroupPage=no
SetupIconFile=${expandFilename(getAppDir() / "setup.ico").toWin}
UninstallDisplayIcon={app}\uninstall.ico

[Languages]
Name: english; MessagesFile: compiler:Default.isl

[Files]
  #for i in low(FileCategory)..fcWindows:
  #  for f in items(c.cat[i]):
  #    let rawDir = if isAbsolute(f): "" else: splitFile(f).dir
  #    let fDir = if rawDir.startsWith(".."): "" else: rawDir
Source: ${expandFilename(f).toWin}; DestDir: {app}${if fDir.len > 0: "\\" & fDir.toWin else: ""}; Flags: ignoreversion
  #  end for
  #end for

[Tasks]
Name: desktopicon; Description: {cm:CreateDesktopIcon}; GroupDescription: {cm:AdditionalIcons}
Name: startmenuicon; Description: Create a &Start Menu shortcut; GroupDescription: {cm:AdditionalIcons}
  #if c.binPaths.len > 0:
Name: modifypath; Description: &Add $c.displayName to your system path (if not in path already);
  #end if

[Icons]
  #if c.app == appConsole:
Name: {group}\$startMenuName; Filename: {cmd}; Tasks: startmenuicon
  #else:
Name: {group}\$startMenuName; Filename: {app}\${c.name}.exe; Tasks: startmenuicon
  #end if
  #for f in items(c.cat[fcDocStart]):
Name: {group}\${docShortcutName(c, f)}; Filename: {app}\${f.toWin}; Tasks: startmenuicon
  #end for
Name: {commondesktop}\$c.displayName; Filename: {app}\${c.name}.exe; Tasks: desktopicon

[Run]
Filename: {app}\${c.name & ".exe"}; Description: {cm:LaunchProgram,$c.displayName}; Flags: nowait postinstall skipifsilent

[Code]
const
  UninstKey = 'Software\Microsoft\Windows\CurrentVersion\Uninstall\${pasStr(c.name)}';
  #if c.binPaths.len > 0:
  EnvKey = 'SYSTEM\CurrentControlSet\Control\Session Manager\Environment';

function ModPathDir(): TArrayOfString;
begin
  setArrayLength(result, $c.binPaths.len);
    #var i = 0
    #for b in items(c.binPaths):
  result[$i] := ExpandConstant('{app}') + '\${pasStr(b.toWin)}';
      #inc(i)
    #end for
end;

// Appends each bin directory to the system PATH unless it is already there
// and returns all of them, separated by ';', so that uninstaller.exe can
// remove them again.
function ModPath(): String;
var
  curPath: String;
  pathdir: TArrayOfString;
  d: Integer;
begin
  result := '';
  pathdir := ModPathDir();
  for d := 0 to GetArrayLength(pathdir)-1 do begin
    if not RegQueryStringValue(HKLM, EnvKey, 'Path', curPath) then
      curPath := '';
    if Pos(';' + UpperCase(pathdir[d]) + ';', ';' + UpperCase(curPath) + ';') = 0 then begin
      if (curPath <> '') and (curPath[Length(curPath)] <> ';') then
        curPath := curPath + ';';
      RegWriteExpandStringValue(HKLM, EnvKey, 'Path', curPath + pathdir[d]);
    end;
    if result <> '' then result := result + ';';
    result := result + pathdir[d];
  end;
end;
  #end if

// Stores Value under UninstKey, or removes a stale value left behind by an
// earlier installation when Value is empty.
procedure WriteUninstValue(const Name, Value: String);
begin
  if Value <> '' then
    RegWriteStringValue(HKLM, UninstKey, Name, Value)
  else
    RegDeleteValue(HKLM, UninstKey, Name);
end;

procedure CurStepChanged(CurStep: TSetupStep);
var
  startMenuDir, startMenuShortcut, docShortcuts, desktopShortcut: String;
begin
  if CurStep = ssPostInstall then begin
    #if c.binPaths.len > 0:
    if WizardIsTaskSelected('modifypath') then
      RegWriteStringValue(HKLM, UninstKey, 'PathEntries', ModPath());
    #end if

    // Write our own Add/Remove Programs entry pointing at uninstaller.exe
    RegWriteStringValue(HKLM, UninstKey, 'DisplayName', '${pasStr(c.displayName)}');
    RegWriteStringValue(HKLM, UninstKey, 'DisplayVersion', '${pasStr(c.version)}');
    RegWriteStringValue(HKLM, UninstKey, 'Publisher', '${pasStr(publisher)}');
    RegWriteStringValue(HKLM, UninstKey, 'InstallLocation', ExpandConstant('{app}'));
    RegWriteStringValue(HKLM, UninstKey, 'UninstallString',
      '"' + ExpandConstant('{app}') + '\uninstaller.exe"');
    RegWriteStringValue(HKLM, UninstKey, 'DisplayIcon',
      ExpandConstant('{app}') + '\${pasStr(c.name)}.exe');
    RegWriteDWordValue(HKLM, UninstKey, 'NoModify', 1);
    RegWriteDWordValue(HKLM, UninstKey, 'NoRepair', 1);

    // Store the shortcuts that were actually created, so uninstaller.exe
    // removes those and nothing else
    desktopShortcut := '';
    if WizardIsTaskSelected('desktopicon') then
      desktopShortcut := ExpandConstant('{commondesktop}') + '\${pasStr(c.displayName)}.lnk';

    startMenuDir := '';
    startMenuShortcut := '';
    docShortcuts := '';
    if WizardIsTaskSelected('startmenuicon') and not WizardNoIcons then begin
      startMenuDir := ExpandConstant('{group}');
      startMenuShortcut := startMenuDir + '\${pasStr(startMenuName)}.lnk';
    #for f in items(c.cat[fcDocStart]):
      if docShortcuts <> '' then docShortcuts := docShortcuts + ';';
      docShortcuts := docShortcuts + startMenuDir + '\${pasStr(docShortcutName(c, f))}.lnk';
    #end for
    end;

    WriteUninstValue('DesktopShortcut', desktopShortcut);
    WriteUninstValue('StartMenuDir', startMenuDir);
    WriteUninstValue('StartMenuShortcut', startMenuShortcut);
    WriteUninstValue('DocShortcuts', docShortcuts);
  end;
end;
